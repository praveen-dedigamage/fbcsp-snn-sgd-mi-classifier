# ======================
# DATA & MODEL FILES (anywhere in project)
# ======================
**/*.npy
**/*.npz
**/*.h5
**/*.pt
**/*.pth
**/*.mat
**/*.gdf
**/*.csv
**/*.tsv
**/*.sav
**/*.arff
**/*.joblib
**/*.pkl
**/*.set
**/*.fdt
**/*.asv

# Allow results directory — unblock small analysis files but keep large binaries ignored
!Results/
!Results/**/*.json
!Results/**/*.csv
!Results/**/*.png



# ======================
# NOTEBOOK CHECKPOINTS
# ======================
**/.ipynb_checkpoints/

# ======================
# PYTHON CACHE / BYTECODE
# ======================
__pycache__/
*.py[cod]
*.so

# ======================
# VIRTUAL ENVIRONMENTS
# ======================
env/
venv/
.venv/

# ======================
# LOGS & CHECKPOINTS
# ======================
logs/
**/*.log
checkpoints/
runs/               # for TensorBoard
wandb/
lightning_logs/

# ======================
# TEMPORARY EXPORTS & ARCHIVES
# ======================
*.zip
*.tar
*.gz
*.rar
*.7z
*.tmp
*.bak

Development/*

# ======================
# IDE / EDITOR / TOOL SETTINGS
# ======================
.vscode/
.idea/
.spyderproject
.spyproject

# ======================
# OS-SPECIFIC FILES
# ======================
.DS_Store
Thumbs.db

SnnTorchGPU/
